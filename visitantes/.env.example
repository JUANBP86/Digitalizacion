# ====================================================================
# GOTUPLAS - Configuración de entorno y base de datos PostgreSQL
# ====================================================================

# Cadena de conexión principal (Recomendado):
# Formato: postgresql://[usuario]:[password]@[host]:[puerto]/[nombre_base_datos]
DATABASE_URL=postgresql://postgres:Got0p1@s@localhost:5432/visitantes_gotuplas

# O si prefieres configurar variables individuales de PostgreSQL:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=visitantes_gotuplas
# PGUSER=postgres
# PGPASSWORD=Got0p1@s

# Puerto de la aplicación (por defecto 8501)
# GOTUPLAS_PORT=8501

# Clave secreta para sesiones Flask (opcional, si se deja vacía se genera automáticamente)
# GOTUPLAS_SECRET_KEY=
