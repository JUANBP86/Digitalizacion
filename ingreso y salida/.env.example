# Clave persistente para proteger las sesiones. Genere una aleatoria antes de publicar.
INGRESOS_SECRET_KEY=

# Puerto web; predeterminado: 8501
INGRESOS_PORT=8501

# URL de PostgreSQL. Cree primero la base de datos desde pgAdmin o psql.
# Reemplace el usuario, la clave y el nombre de la base según su instalación.
INGRESOS_DATABASE_URL=postgresql://postgres:CAMBIE_ESTA_CLAVE@localhost:5432/ingresos_personal
# Configure esta URL en .env y luego ejecute:
# .venv\Scripts\python.exe migrar_a_postgres.py

# Ruta de la base SQLite anterior, usada solo por migrar_a_postgres.py.
# INGRESOS_SQLITE_PATH=D:\ruta\al\proyecto\instance\ingresos_personal.db
